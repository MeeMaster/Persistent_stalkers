-- Persistent Stalkers in MCM (Mod Configuration Menu): what the profile
-- carries, and constant saves.
--
--   Carried: money, rank and reputation, faction goodwill, faction, needs,
--     skills and other mod state, recipes. Items always. Health, bleeding,
--     body parts, radiation and psy health stay with the loaded save.
--   Constant saves (a checkbox, last on the page, off by default): ticked,
--     the character lives in the profile ("profile" mode, written on every
--     change); unticked, it follows the save ("save" mode). See
--     persistent_stalkers.script. Until 2026-11-12 this was a dropdown with
--     Off as well; Off is now the None profile at the main menu.
--
-- No profiles here: choosing, creating and removing them is the main menu's
-- (ui_main_menu.script, persistent_stalkers_menu.script), before a game.
--
-- MCM finds this file by its name (*mcm.script) and calls on_mcm_load.

local function check(id, def)
	return { id = id, type = "check", val = 1, def = def }
end

function on_mcm_load()
	return {
		id = "persistent_stalkers",
		sh = true,
		gr = {
			{ id = "title", type = "title", text = "ui_mcm_persistent_stalkers_title", align = "l", clr = { 255, 196, 18, 18 } },
			{ id = "title_parts", type = "title", text = "ui_mcm_persistent_stalkers_title_parts", align = "l", clr = { 255, 196, 18, 18 } },
			check("carry_money", true),
			check("carry_rank", true),
			check("carry_goodwill", true),
			check("carry_faction", false),
			check("carry_needs", true),
			check("carry_mod_state", true),
			check("carry_skill_tree", true),
			check("carry_recipes", true),
			check("death_strip", false),
			{ id = "line_saves", type = "line" },
			check("constant_saves", false),
		},
	}
end
