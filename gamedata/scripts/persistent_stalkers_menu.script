-- Persistent Stalkers: the profile panel of the main menu (AGENTS.md, "The
-- main menu").
--
-- ui_main_menu.script attaches it (attach(mm)) each time the menu is made:
-- at the main menu, and as the pause menu in a game. It sits left to middle;
-- the game's options are on the right.
--
-- Left: the profiles, None first. At the main menu a click selects: that is
-- the profile every game started, loaded or joined from here is played with
-- (persistent_stalkers_profile.choose, remembered in a file). "New profile"
-- opens a small box for the name; the new one is empty and is selected.
-- "Remove profile" removes the selected row (never default, never None)
-- after a warning box; default is selected instead, and the files are kept
-- as a backup. In a game the panel only shows the profile in use: changing
-- it means quitting to the main menu.
-- Debug mode only (the game started with -dbg, DEV_DEBUG): F8 in a game
-- opens the same panel in a window of its own (UISwitchMenu) with every
-- row. A click shows the row; "Switch to" runs persistent_stalkers.switch_to
-- (the profile in use written, then the new one's character applied) once
-- the window is closed. F8, Esc or Close shut it.
-- Right of the list: the selected row's character, read only: its name and
-- stats, then its loadout: the equipment column exactly as G.A.M.M.A.'s
-- inventory lays it out (its background, slot cells, condition bars and
-- blockers, scaled down), the backpack as a grid of icons beside it, the
-- game's item card on hover. Below: what playing with it does.
--
-- Icons are each item's inv_grid_* cell of its icons_texture, 50 px a cell.
-- The window is 1024x768 units stretched to the screen: on 16:9 a unit is
-- wider than tall, so widths are multiplied by utils_xml.screen_ratio() to
-- keep icons their shape.

local XML_FILE = "ui_persistent_stalkers.xml"
local ROWS = 12 -- profile rows shown at once; the arrows page through more
local ICON_PX = 50 -- pixels a grid cell in the icon textures
local BAG_CELLS = { 30, 26, 22, 18, 15, 12, 10 } -- backpack cell heights tried, largest that fits
-- The equipment column as G.A.M.M.A.'s inventory has it (G.A.M.M.A. UI's
-- ui_inventory_16.xml, "equipment", used at every aspect ratio): 273 x 768
-- of its units, which are already narrowed for 16:9 (ratio 0.75), over the
-- background ui_inGame2_inventory_back. Shown from the top down to below the
-- belt (crop), scaled to the panel's height.
local INV = { w = 273, h = 768, crop = 566, ratio = 0.75 }

-- Slot cells (cont_equ): slot, x, y, w, h, then the condition bar's x, y, w
-- inside the cell (nil: none), and whether the icon is turned 90 degrees
-- (the pistol and rifle cells). G.A.M.M.A. slots: 1 knife, 2 pistol,
-- 3 rifle, 4 grenade, 5 binoculars, 6 bolt, 7 outfit, 8 PDA, 9 detector,
-- 10 torch, 12 helmet, 13 backpack. 11 (artefact) is off screen there:
-- what it holds is shown in the backpack.
local EQUIP = {
	{ 1, 10, 376, 73, 36, 13, 40, 48 },
	{ 2, 8, 74, 76, 233, 13, 234, 48, true },
	{ 3, 187, 74, 78, 233, 14, 234, 48, true },
	{ 4, 51, 323, 33, 41 },
	{ 5, 10, 11, 73, 47, 16, 49, 48 },
	{ 6, 10, 323, 33, 41 },
	{ 7, 91, 132, 89, 173, 19, 176, 48 },
	{ 8, 190, 322, 73, 36, 11, 40, 48 },
	{ 9, 190, 376, 73, 36, 11, 40, 48 },
	{ 10, 190, 11, 73, 47, 11, 49, 48 },
	{ 12, 91, 11, 89, 104, 19, 107, 48 },
	{ 13, 91, 322, 89, 91, 19, 93, 48 },
}
-- Shown over the helmet and backpack cells when the outfit has no room for one.
local SLOT_BLOCKERS = { [12] = { 90, 10, 91, 115 }, [13] = { 90, 320, 91, 103 } }
-- The belt (cont_belt at y 510): five cells 33 x 41, a blocker over each
-- one the outfit does not open.
local BELT_Y = 510
local BELT_X = { 16, 68, 120, 172, 224 }
local BELT_W, BELT_H = 33, 41
local BELT_BLOCKER = { -9, -10, 48, 61 } -- x, y from the cell, w, h
local BAR_H = 6

local CLR_TITLE = { 235, 200, 75 }
local CLR_ROW = { 225, 220, 200 }
local CLR_ROW_ON = { 235, 200, 75 }
local CLR_ROW_DIM = { 150, 150, 140 }

local function core()
	return rawget(_G, "persistent_stalkers") or persistent_stalkers
end

local function profile()
	return rawget(_G, "persistent_stalkers_profile") or persistent_stalkers_profile
end

local function state()
	return rawget(_G, "persistent_stalkers_state") or persistent_stalkers_state
end

local function log(fmt, ...)
	printf("[PersistentStalkers] " .. fmt, ...)
end

-- Window code runs from engine events; an error is logged instead of lost.
local function guard(what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		log("! menu %s failed: %s", what, tostring(err))
	end
	return ok, err
end

local function color(t, a)
	return GetARGB(a or 255, t[1], t[2], t[3])
end

local function at(wnd, x, y, w, h)
	wnd:SetWndPos(vector2():set(x, y))
	if w then
		wnd:SetWndSize(vector2():set(w, h))
	end
end

-- Width of one screen pixel in window units over its height (0.75 on 16:9).
local function unit_ratio()
	local ok, r = pcall(utils_xml.screen_ratio)
	return ok and type(r) == "number" and r > 0 and r or 1
end

local function section_ok(sec)
	return type(sec) == "string" and ini_sys:section_exist(sec)
end

local function grid_size(sec)
	return math.max(1, ini_sys:r_float_ex(sec, "inv_grid_width") or 1), math.max(1, ini_sys:r_float_ex(sec, "inv_grid_height") or 1)
end

-- Artefact slots a stored outfit opens: its artefact_count, plus what its
-- upgrades add (an upgrade's property section, "section", adds its own).
local function artefact_slots(it)
	local n = 0
	pcall(function()
		n = ini_sys:r_float_ex(it.section, "artefact_count") or 0
		for _, u in ipairs(type(it.upgrades) == "table" and it.upgrades or {}) do
			local prop = section_ok(u) and ini_sys:r_string_ex(u, "section")
			if prop and section_ok(prop) then
				n = n + (ini_sys:r_float_ex(prop, "artefact_count") or 0)
			end
		end
	end)
	return math.max(0, math.min(#BELT_X, math.floor(n)))
end

-- Whether a stored outfit leaves room for a helmet and a backpack (the
-- engine's helmet_avaliable / backpack_avaliable, true when not given).
local function outfit_room(it)
	if not (it and section_ok(it.section)) then
		return true, true
	end
	local ok, helm, bkpk = pcall(function()
		return ini_sys:r_bool_ex(it.section, "helmet_avaliable", true), ini_sys:r_bool_ex(it.section, "backpack_avaliable", true)
	end)
	if not ok then
		return true, true
	end
	return helm ~= false, bkpk ~= false
end

local SWITCH_KEY = DIK_keys and DIK_keys.DIK_F8 -- debug mode only

-- The game was started with -dbg.
local function debug_mode()
	return DEV_DEBUG and true or false
end

------------------------------------------------------------------ the panel

-- Not a window of its own: its controls are children of a static of its
-- owner (the main menu, or the debug switch window), and its buttons are
-- registered with the owner (names pst_*).
--   how: "menu"   the main menu: every row, a click selects for the next game
--        "pause"  the pause menu in a game: the profile in use, read only
--        "switch" the debug window in a game: every row, "Switch to"
class "ProfilePanel"

function ProfilePanel:__init(mm, how)
	self.mm = mm
	self.how = how or (level.present() and "pause" or "menu")
	self.in_game = self.how ~= "menu"
	self.first = 1 -- the first profile row shown
	self.rows = {}
	self.cells = {} -- { wnd, sec } of the shown loadout, for the hover card
	self.R = unit_ratio()
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(XML_FILE)
	self.wnd = self.xml:InitStatic("menu:panel", mm)
	local p = profile()
	if not self.in_game then
		-- no game: nothing is in use, the selection is what counts
		p.unpin()
	end
	self:Build()
	self.chosen = p.current_profile()
	self:Refresh()
end

function ProfilePanel:Button(node, name, fn)
	local b = self.xml:Init3tButton(node, self.wnd)
	self.mm:Register(b, name)
	self.mm:AddCallback(name, ui_events.BUTTON_CLICKED, function() guard(name, fn, self) end, self.mm)
	return b
end

function ProfilePanel:Build()
	local xml, wnd = self.xml, self.wnd
	xml:InitFrame("menu:background", wnd)
	self.title = xml:InitTextWnd("menu:title", wnd)
	self.list_title = xml:InitTextWnd("menu:list_title", wnd)
	-- Rows are check buttons with their text on top, as MCM's own list
	-- (elements:btn_list): the selected one is kept checked, so it stays
	-- pressed (SetCheck in Refresh).
	local row = xml:InitStatic("menu:row", wnd)
	local pos = row:GetWndPos()
	local rw, rh = row:GetWidth(), row:GetHeight()
	row:Show(false)
	self.row_texts = {}
	for i = 1, ROWS do
		local name = "pst_row_" .. i
		local y = pos.y + (i - 1) * (rh + 3)
		local b = xml:InitCheck("menu:row", wnd)
		self.mm:Register(b, name)
		self.mm:AddCallback(name, ui_events.BUTTON_CLICKED, function() guard(name, self.OnRow, self, i) end, self.mm)
		at(b, pos.x, y, rw, rh)
		local t = xml:InitTextWnd("menu:row_text", wnd)
		at(t, pos.x + 8, y, rw - 12, rh)
		self.rows[i] = b
		self.row_texts[i] = t
	end
	self.btn_up = self:Button("menu:btn_up", "pst_btn_up", function(s) s:Page(-1) end)
	self.btn_down = self:Button("menu:btn_down", "pst_btn_down", function(s) s:Page(1) end)
	self.btn_new = self:Button("menu:btn_new", "pst_btn_new", self.OnNew)
	self.btn_new:Show(not self.in_game)
	self.btn_remove = self:Button("menu:btn_remove", "pst_btn_remove", self.OnRemove)
	self.btn_remove:Show(false)
	if self.how == "switch" then
		self.btn_switch = self:Button("menu:btn_switch", "pst_btn_switch", self.OnSwitch)
		self.btn_close = self:Button("menu:btn_close", "pst_btn_close", function(s) s.mm:Close() end)
		self.btn_close:TextControl():SetText("Close")
	end
	self.note = xml:InitTextWnd("menu:note", wnd)

	self.details = xml:InitTextWnd("menu:details", wnd)
	self.equip = xml:InitStatic("menu:equip", wnd)
	self:BuildColumn()
	self.bag = xml:InitStatic("menu:bag", wnd)
	self.bag_caption = xml:InitTextWnd("menu:bag_caption", wnd)
	-- the backpack goes right of the column (whose width depends on the
	-- screen), up to its own right edge in the layout
	local bpos = self.bag:GetWndPos()
	local right = bpos.x + self.bag:GetWidth()
	local bx = self.equip:GetWndPos().x + self.equip:GetWidth() + 10
	at(self.bag, bx, bpos.y, math.max(40, right - bx), self.bag:GetHeight())
	at(self.bag_caption, bx, self.bag_caption:GetWndPos().y, math.max(40, right - bx), self.bag_caption:GetHeight())
	self.what = xml:InitTextWnd("menu:what", wnd)

	local titles = {
		menu = { "Choose your character", "Profiles" },
		pause = { "Your character in this game", "Profile in use" },
		switch = { "Switch profiles (debug mode)", "Profiles" },
	}
	self.title:SetText(titles[self.how][1])
	self.list_title:SetText(titles[self.how][2])
	self.btn_new:TextControl():SetText("New profile")
	self.btn_remove:TextControl():SetText("Remove profile")
	self.btn_up:TextControl():SetText("Up")
	self.btn_down:TextControl():SetText("Down")
	self.bag_caption:SetText("Backpack")

	local ok, info = pcall(function() return utils_ui.UIInfoItem(self.mm, 400) end)
	self.info = ok and info or nil
	if not ok then
		log("! menu: no item card (%s)", tostring(info))
	end
end

-- The equipment column: G.A.M.M.A.'s, scaled to the panel's height (s) and
-- widened or narrowed from the 16:9 its units are made for to this screen
-- (k). Its background is the inventory's own, cut off below the belt; if the
-- cut cannot be made, the background is left out and the cells get boxes.
function ProfilePanel:BuildColumn()
	local ph = self.equip:GetHeight()
	self.s = ph / INV.crop
	self.k = self.R / INV.ratio
	local pos = self.equip:GetWndPos()
	local w = INV.w * self.s * self.k
	at(self.equip, pos.x, pos.y, w, ph)
	local bg = self.xml:InitStatic("menu:inv_back", self.equip)
	at(bg, 0, 0, w, ph)
	local ok, err = pcall(function()
		local r = bg:GetTextureRect()
		local h = (r.y2 - r.y1) * INV.crop / INV.h
		assert(h > 0 and r.x2 > r.x1, "no texture rect")
		bg:SetTextureRect(Frect():set(r.x1, r.y1, r.x2, r.y1 + h))
	end)
	if not ok then
		bg:Show(false)
		log("! menu: the inventory background could not be cut (%s); plain boxes instead", tostring(err))
	end
	self.inv_bg = ok
end

-- A cell of the column in window units, from G.A.M.M.A.'s units.
function ProfilePanel:InvBox(x, y, w, h)
	local sx = self.s * self.k
	return x * sx, y * self.s, w * sx, h * self.s
end

-- The rows' values. At the main menu and in the debug window: None first,
-- then every profile. In the pause menu: only what is in use.
function ProfilePanel:Entries()
	local p = profile()
	if self.how == "pause" then
		return { p.current_profile() }
	end
	local t = { p.NONE }
	for _, n in ipairs(p.profiles()) do
		t[#t + 1] = n
	end
	return t
end

function ProfilePanel:Label(name)
	local p = profile()
	if name == p.NONE then
		return "None: each save's own"
	end
	local i = p.info(name)
	local label = name
	local cls = class_name(i and i.character)
	if cls then
		label = label .. " - " .. cls
	end
	if self.how == "switch" and name == p.current_profile() and core().get_phase() == "live" then
		label = label .. "  (in use)"
	elseif not (i and i.character) then
		label = label .. "  (empty)"
	end
	return label
end

function ProfilePanel:Refresh()
	local entries = self:Entries()
	self.entries = entries
	if #entries <= ROWS then
		self.first = 1
	else
		self.first = math.max(1, math.min(self.first, #entries - ROWS + 1))
	end
	for i, b in ipairs(self.rows) do
		local name = entries[self.first + i - 1]
		local t = self.row_texts[i]
		b:Show(name ~= nil)
		t:Show(name ~= nil)
		if name then
			local on = name == self.chosen
			pcall(function() b:SetCheck(on) end)
			t:SetText(self:Label(name))
			t:SetTextColor(color(on and CLR_ROW_ON or CLR_ROW))
		end
	end
	self.btn_up:Show(#entries > ROWS)
	self.btn_down:Show(#entries > ROWS)
	self.btn_remove:Show(self:Removable(self.chosen))
	self:ShowChosen()
end

function ProfilePanel:Page(d)
	self.first = self.first + d * (ROWS - 1)
	self:Refresh()
end

-- Brings the row of name into view.
function ProfilePanel:Reveal(name)
	for i, n in ipairs(self:Entries()) do
		if n == name then
			if i < self.first or i > self.first + ROWS - 1 then
				self.first = math.max(1, i - ROWS + 1)
			end
			return
		end
	end
end

-- Makes name the selection: the profile the next game is played with. Only
-- at the main menu.
function ProfilePanel:Select(name)
	if self.in_game then
		return false
	end
	local p = profile()
	if name ~= p.current_profile() then
		if not p.choose(name) then
			log("! menu: %s could not be selected", tostring(name))
			return false
		end
		log("profile selected at the main menu: %s", name)
	end
	self.chosen = name
	self:Reveal(name)
	self:Refresh()
	return true
end

function ProfilePanel:OnRow(i)
	local name = self.entries and self.entries[self.first + i - 1]
	if name and self.how == "menu" then
		self:Select(name)
	elseif name and self.how == "switch" then
		-- only shown: the switch is the button's
		self.chosen = name
		self:Refresh()
	else
		self:Refresh() -- puts the row's check back
	end
end

-- The row is what the game is played with now (the debug window).
function ProfilePanel:InUse(name)
	local p, phase = profile(), core().get_phase()
	return (name == p.NONE and phase == "none") or (name == p.current_profile() and phase == "live")
end

-- What playing with the row means, for the line under the loadout.
function ProfilePanel:Describe(name, has_character)
	local p = profile()
	local constant = core().chosen_mode() == "profile"
	if self.how == "pause" then
		local change = " To play another one, quit to the main menu and choose it there."
		if name == p.NONE then
			return "You are playing this save's own character, without a profile. Nothing is written." .. change
		end
		return string.format("You are playing as %s.", name) .. change
	end
	if self.how == "switch" then
		local cur = core().get_phase() == "live" and p.current_profile() or nil
		if self:InUse(name) then
			return name == p.NONE and "You are playing without a profile." or string.format("You are playing as %s.", name)
		end
		if name == p.NONE then
			return string.format("Stop using %s: it is written now, and nothing after. You keep your character.", tostring(cur))
		end
		local first = cur and string.format("%s is written first. ", cur) or ""
		if not has_character then
			return first .. string.format("%s is empty: it takes the character you have now (a copy).", name)
		end
		return first .. string.format("Then %s's character replaces yours: gear, and what is ticked in MCM. Health and bleeding stay. Save the game afterwards so your saves follow %s.", name, name)
	end
	if name == p.NONE then
		return "No profile: every game is played with its own character, as without this mod. Nothing is read or written."
	end
	if not has_character then
		return string.format("%s is empty: it takes the character of the first game you start, load or join with it. A new game gives it the starting character; a save gives it a copy of that save's character.", name)
	end
	if constant then
		return string.format("Every game you start, load or join is played as %s, exactly as you left it (constant saves). Health and bleeding stay the save's.", name)
	end
	return string.format("Every game you start, load or join is played as %s. A save you made as %s keeps that save's character; any other game gets %s as it was at your last save. Health and bleeding stay the save's.", name, name, name)
end

-- The selected row's character. None has none at the main menu; in a game
-- it shows the actor as it is now.
function ProfilePanel:ShowChosen()
	local p = profile()
	local name = self.chosen
	local c, head
	if name == p.NONE then
		if self.in_game and db.actor then
			local ok, cur = pcall(state().read)
			c = ok and cur or nil
		end
		head = string.format("%%c[255,235,200,75]%s%%c[default]", self.in_game and "This save's character" or "No profile")
	else
		local i = p.info(name) or {}
		c = i.character
		local when = i.written and os.date("%Y-%m-%d %H:%M", i.written) or "never"
		head = string.format("%%c[255,235,200,75]%s%%c[default]   written %s, revision %s%s", name, when,
			tostring(i.revision or 0), c and c.nick and (", by " .. tostring(c.nick)) or "")
	end
	local lines = { head }
	if c then
		local skills = 0
		local sl = type(c.mod_state) == "table" and c.mod_state.skills_levels
		if type(sl) == "table" then
			for _, v in pairs(sl) do
				if type(v) == "number" then skills = skills + v end
			end
		end
		lines[#lines + 1] = string.format("Money: %s RU    Rank: %s    Reputation: %s    Faction: %s",
			tostring(c.money or "?"), tostring(c.rank or "?"), tostring(c.reputation or "?"),
			c.faction and game.translate_string(c.faction) or "?")
		lines[#lines + 1] = string.format("Items: %s    Recipes: %s%s", type(c.items) == "table" and #c.items or 0,
			type(c.recipes) == "table" and #c.recipes or 0, skills > 0 and ("    Skill levels: " .. skills) or "")
		local st = type(c.skill_tree) == "table" and c.skill_tree
		if st then
			local perks = 0
			for _ in pairs(type(st.perks) == "table" and st.perks or {}) do perks = perks + 1 end
			local xp = type(st.xp) == "table" and st.xp or {}
			local cxp = st.class and type(xp.class) == "table" and xp.class[st.class]
			lines[#lines + 1] = string.format("Class: %s    Perks: %s    XP: %s general%s",
				class_name(c) or "none", perks,
				tostring(xp.general or 0), cxp and (", " .. tostring(cxp) .. " class") or "")
		end
	elseif name ~= p.NONE then
		lines[#lines + 1] = "Empty: no character yet."
	end
	self.details:SetText(table.concat(lines, " \\n"))
	guard("loadout", self.ShowLoadout, self, c)
	self.what:SetText(self:Describe(name, c ~= nil))
	local constant = core().chosen_mode() == "profile"
	self.note:SetText((constant and "Constant saves: on (MCM). The character is written whenever it changes."
		or "The character follows the save: it is written when you save. Constant saves are in MCM.")
		.. (self.how == "switch" and " \\n \\nDebug mode (-dbg): F8 or Esc closes this." or ""))
	if self.btn_switch then
		self.btn_switch:Enable(not self:InUse(name))
		self.btn_switch:TextControl():SetText(name == p.NONE and "Stop using a profile" or ("Switch to " .. name))
	end
end

-- The Skill tree class of a stored character (its translated name), or nil
-- when it has none or the profile was written without Skill tree.
function class_name(c)
	local st = type(c) == "table" and type(c.skill_tree) == "table" and c.skill_tree
	local cls = st and st.class
	if type(cls) ~= "string" or cls == "" then
		return nil
	end
	local ok, s = pcall(game.translate_string, "st_spec_class_" .. cls)
	return ok and type(s) == "string" and s ~= "st_spec_class_" .. cls and s or cls
end

------------------------------------------------------------------ the loadout

function ProfilePanel:ClearLoadout()
	if self.equip_layer then self.equip:DetachChild(self.equip_layer) end
	if self.bag_layer then self.bag:DetachChild(self.bag_layer) end
	self.equip_layer, self.bag_layer = nil, nil
	self.cells = {}
end

-- An item's icon in layer, fitted into the box (x, y, w, h: units) keeping
-- its shape on screen, with its condition bar and a count. Returns the icon.
-- opts: rot (turned 90 degrees, as the inventory's pistol and rifle cells;
-- the window is sized as G.A.M.M.A.'s utils_ui does it: the ratio goes to
-- the height, which lies across the screen once turned), bar ({ x, y, w, h }:
-- a slot's condition bar, the inventory's grey one, always shown).
function ProfilePanel:Icon(layer, it, x, y, w, h, count, opts)
	opts = opts or {}
	local sec = it.section
	if not section_ok(sec) then
		return nil
	end
	local gx, gy = ini_sys:r_float_ex(sec, "inv_grid_x") or 0, ini_sys:r_float_ex(sec, "inv_grid_y") or 0
	local gw, gh = grid_size(sec)
	local iw, ih
	if opts.rot then
		local s = math.min(w / (gh * self.R), h / gw)
		iw, ih = gw * s, gh * s * self.R
	else
		local s = math.min(w / (gw * self.R), h / gh)
		iw, ih = gw * self.R * s, gh * s
	end
	local ix, iy = x + (w - iw) / 2, y + (h - ih) / 2
	local st = self.xml:InitStatic("menu:icon", layer)
	st:InitTexture(ini_sys:r_string_ex(sec, "icons_texture") or "ui\\ui_icon_equipment")
	st:SetTextureRect(Frect():set(gx * ICON_PX, gy * ICON_PX, (gx + gw) * ICON_PX, (gy + gh) * ICON_PX))
	at(st, ix, iy, iw, ih)
	if opts.rot then
		pcall(function()
			st:EnableHeading(true)
			st:SetHeading(math.pi / 2)
		end)
	end
	local cond = tonumber(it.cond)
	if opts.bar then
		if cond then
			local b = opts.bar
			local bar = self.xml:InitStatic("menu:slot_bar", layer)
			at(bar, b[1], b[2], math.max(1, b[3] * math.max(0, math.min(1, cond))), b[4])
		end
	elseif cond and cond < 0.999 and (it.slot or sec:find("^wpn_") or ini_sys:r_bool_ex(sec, "use_condition", false)) then
		local bar = self.xml:InitStatic("menu:bar", layer)
		local c = math.max(0, math.min(1, cond))
		at(bar, x + 2, y + h - 3, math.max(1, (w - 4) * c), 2)
		bar:SetTextureColor(GetARGB(230, math.floor(255 * (1 - c)), math.floor(200 * c + 40), 40))
	end
	if count and count > 1 then
		local t = self.xml:InitTextWnd("menu:count", layer)
		at(t, x, y + h - 14, w - 2, 13)
		t:SetText("x" .. count)
	end
	self.cells[#self.cells + 1] = { wnd = st, sec = sec }
	return st
end

-- Backpack stacks: one per section for plain items; weapons, upgraded and
-- loaded items alone.
local function stacks(items)
	local out, by = {}, {}
	for _, it in ipairs(items) do
		local alone = it.section:find("^wpn_") or (type(it.upgrades) == "table" and #it.upgrades > 0) or it.mag or it.ammo_type
		local key = not alone and (it.section .. "|" .. tostring(it.uses or "")) or nil
		if key and by[key] then
			by[key].count = by[key].count + 1
		else
			local w, h = grid_size(it.section)
			local s = { it = it, count = 1, w = w, h = h }
			out[#out + 1] = s
			if key then by[key] = s end
		end
	end
	table.sort(out, function(a, b)
		if a.w * a.h ~= b.w * b.h then return a.w * a.h > b.w * b.h end
		return a.it.section < b.it.section
	end)
	return out
end

-- First fit on a grid cols wide, as the inventory packs. Returns rows used.
local function pack(list, cols)
	local used = {}
	local function free(c, r, w, h)
		for y = r, r + h - 1 do
			for x = c, c + w - 1 do
				if used[y * cols + x] then return false end
			end
		end
		return true
	end
	local rows = 0
	for _, s in ipairs(list) do
		local w, h = math.min(s.w, cols), s.h
		local r = 0
		while not s.col do
			for c = 0, cols - w do
				if free(c, r, w, h) then
					for y = r, r + h - 1 do
						for x = c, c + w - 1 do used[y * cols + x] = true end
					end
					s.col, s.row = c, r
					rows = math.max(rows, r + h)
					break
				end
			end
			r = r + 1
		end
	end
	return rows
end

function ProfilePanel:ShowLoadout(c)
	self:ClearLoadout()
	self.equip_layer = self.xml:InitStatic("menu:layer", self.equip)
	self.bag_layer = self.xml:InitStatic("menu:layer", self.bag)
	local EW, EH = self.equip:GetWidth(), self.equip:GetHeight()
	local BW, BH = self.bag:GetWidth(), self.bag:GetHeight()
	at(self.equip_layer, 0, 0, EW, EH)
	at(self.bag_layer, 0, 0, BW, BH)
	local items = c and type(c.items) == "table" and c.items or {}

	-- equipment: G.A.M.M.A.'s cells over its background
	local belt, slots, rest = {}, {}, {}
	for _, it in ipairs(items) do
		if type(it.section) == "string" then
			if it.belt then
				belt[#belt + 1] = it
			elseif it.slot and not slots[it.slot] then
				slots[it.slot] = it
			else
				rest[#rest + 1] = it
			end
		end
	end
	table.sort(belt, function(a, b) return (tonumber(a.belt) or 0) < (tonumber(b.belt) or 0) end)
	local layer = self.equip_layer
	local function plain_box(x, y, w, h)
		if not self.inv_bg then
			local bg = self.xml:InitStatic("menu:slot_bg", layer)
			at(bg, x, y, w, h)
		end
	end
	local helm_room, bkpk_room = outfit_room(slots[7])
	local known = {}
	for _, e in ipairs(EQUIP) do
		local s = e[1]
		known[s] = true
		local x, y, w, h = self:InvBox(e[2], e[3], e[4], e[5])
		plain_box(x, y, w, h)
		local it = slots[s]
		if it then
			local bar
			if e[6] then
				local bx, by, bw, bh = self:InvBox(e[2] + e[6], e[3] + e[7], e[8], BAR_H)
				bar = { bx, by, bw, bh }
			end
			self:Icon(layer, it, x + 1, y + 1, w - 2, h - 2, nil, { rot = e[9], bar = bar })
		end
		local b = SLOT_BLOCKERS[s]
		if b and ((s == 12 and not helm_room) or (s == 13 and not bkpk_room)) then
			local blk = self.xml:InitStatic("menu:helmet_blocker", layer)
			at(blk, self:InvBox(b[1], b[2], b[3], b[4]))
		end
	end
	-- items in a slot the inventory does not show go to the backpack
	for s, it in pairs(slots) do
		if not known[s] then rest[#rest + 1] = it end
	end
	local open = math.max(slots[7] and artefact_slots(slots[7]) or 0, math.min(#belt, #BELT_X))
	for i, bx in ipairs(BELT_X) do
		local x, y, w, h = self:InvBox(bx, BELT_Y, BELT_W, BELT_H)
		plain_box(x, y, w, h)
		if belt[i] then
			self:Icon(layer, belt[i], x + 1, y + 1, w - 2, h - 2)
		end
		if i > open then
			local blk = self.xml:InitStatic("menu:artefact_blocker", layer)
			at(blk, self:InvBox(bx + BELT_BLOCKER[1], BELT_Y + BELT_BLOCKER[2], BELT_BLOCKER[3], BELT_BLOCKER[4]))
		end
	end
	for i = #BELT_X + 1, #belt do
		rest[#rest + 1] = belt[i]
	end

	-- backpack: the largest cell that fits everything
	local list = stacks(rest)
	local cell, cols
	for _, ch in ipairs(BAG_CELLS) do
		cell = ch
		cols = math.max(1, math.floor((BW - 8) / (ch * self.R)))
		for _, s in ipairs(list) do s.col, s.row = nil, nil end
		local rows = pack(list, cols)
		if rows * ch <= BH - 8 then
			break
		end
	end
	local cw = cell * self.R
	for _, s in ipairs(list) do
		local x, y = 4 + s.col * cw, 4 + s.row * cell
		if y + s.h * cell <= BH then
			self:Icon(self.bag_layer, s.it, x + 1, y + 1, math.min(s.w, cols) * cw - 2, s.h * cell - 2, s.count)
		end
	end
end

------------------------------------------------------------------ actions

function ProfilePanel:OnNew()
	if self.in_game then
		return
	end
	-- kept on the main menu, so it lives as long as the menu does
	self.mm.pst_new_dlg = UINewProfile(self)
	self.mm.pst_new_dlg:ShowDialog(true)
end

-- Whether the row can be removed here: a profile, not default, at the main
-- menu.
function ProfilePanel:Removable(name)
	local p = profile()
	return not self.in_game and type(name) == "string" and name ~= p.NONE and name ~= "default" and p.has_profile(name)
end

function ProfilePanel:OnRemove()
	if not self:Removable(self.chosen) then
		return
	end
	self.mm.pst_remove_dlg = UIRemoveProfile(self, self.chosen)
	self.mm.pst_remove_dlg:ShowDialog(true)
end

-- Removes name (the warning box's Remove). Master Core never removes the
-- profile in use, so when it is the selected one default is selected first,
-- and back again if the removal fails. Returns ok, message.
function ProfilePanel:Remove(name)
	if not self:Removable(name) then
		return false, "This profile cannot be removed."
	end
	local p = profile()
	local was = p.current_profile()
	if was == name and not p.choose("default") then
		return false, "default could not be selected."
	end
	local ok, msg = p.remove_profile(name, name)
	if not ok then
		if was == name then
			p.choose(name)
		end
		return false, msg
	end
	log("profile removed at the main menu: %s (%s)", name, tostring(msg))
	self.chosen = p.current_profile()
	self:Reveal(self.chosen)
	self:Refresh()
	return true, msg
end

-- The debug window's "Switch to": runs after the window is closed.
function ProfilePanel:OnSwitch()
	if self.how ~= "switch" or not self.chosen or self:InUse(self.chosen) then
		return
	end
	self.mm:Finish(self.chosen)
end

function ProfilePanel:HideCard()
	pcall(function() self.info:Show(false) end)
end

-- Each frame, from the main menu's Update: the item card under the cursor.
function ProfilePanel:Update()
	if not self.info then
		return
	end
	local hover
	local dlg = (self.mm.pst_new_dlg and self.mm.pst_new_dlg:IsShown()) or (self.mm.pst_remove_dlg and self.mm.pst_remove_dlg:IsShown())
	if self.mm:IsShown() and not dlg then
		for _, c in ipairs(self.cells) do
			if c.wnd:IsCursorOverWindow() then
				hover = c.sec
				break
			end
		end
	end
	local ok, err = pcall(function()
		if hover then
			self.info:Update(nil, hover)
		else
			self.info:Update()
		end
	end)
	if not ok then
		log("! menu: the item card failed (%s); dropped", tostring(err))
		self:HideCard()
		self.info = nil
	end
end

------------------------------------------------------------------ new profile

-- A small box over the main menu: a name, Create, Cancel. Its own dialog, so
-- typing a name never reaches the main menu's keys (Q quits there).
class "UINewProfile" (CUIScriptWnd)

function UINewProfile:__init(panel) super()
	self.panel = panel
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	xml:InitFrame("new_profile:background", self)
	self.title = xml:InitTextWnd("new_profile:title", self)
	self.name = xml:InitEditBox("new_profile:name", self)
	self.hint = xml:InitTextWnd("new_profile:hint", self)
	self.btn_create = xml:Init3tButton("new_profile:btn_create", self)
	self.btn_cancel = xml:Init3tButton("new_profile:btn_cancel", self)
	self:Register(self.btn_create, "btn_create")
	self:Register(self.btn_cancel, "btn_cancel")
	self:AddCallback("btn_create", ui_events.BUTTON_CLICKED, function() guard("create", self.OnCreate, self) end, self)
	self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, function() guard("cancel", self.Close, self) end, self)
	self.title:SetText("New profile: its name")
	self.hint:SetText("Letters, digits, _ and - (up to 32). It starts empty and takes the character of the first game you play with it: a new game's starting character, or the character in the save you load.")
	self.btn_create:TextControl():SetText("Create")
	self.btn_cancel:TextControl():SetText("Cancel")
end

function UINewProfile:__finalize()
end

function UINewProfile:OnCreate()
	local name = self.name:GetText() or ""
	name = name:match("^%s*(.-)%s*$")
	local ok, msg = profile().create_profile(name)
	if not ok then
		self.hint:SetText("%c[255,230,120,90]" .. tostring(msg))
		return
	end
	self:Close()
	guard("select", self.panel.Select, self.panel, name)
end

function UINewProfile:Close()
	if self:IsShown() then
		self:HideDialog()
	end
end

function UINewProfile:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:Close()
			return true
		elseif dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
			guard("create", self.OnCreate, self)
			return true
		end
	end
	return res
end

------------------------------------------------------------------ remove profile

-- The warning box over the main menu: what removing does, how a character
-- comes back, Remove and Cancel (also Esc). Enter does nothing here, so a
-- key held from elsewhere cannot remove a profile.
class "UIRemoveProfile" (CUIScriptWnd)

function UIRemoveProfile:__init(panel, name) super()
	self.panel = panel
	self.name = name
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	xml:InitFrame("remove_profile:background", self)
	self.title = xml:InitTextWnd("remove_profile:title", self)
	self.text = xml:InitTextWnd("remove_profile:message", self)
	self.btn_remove = xml:Init3tButton("remove_profile:btn_remove", self)
	self.btn_cancel = xml:Init3tButton("remove_profile:btn_cancel", self)
	self:Register(self.btn_remove, "btn_remove")
	self:Register(self.btn_cancel, "btn_cancel")
	self:AddCallback("btn_remove", ui_events.BUTTON_CLICKED, function() guard("remove", self.OnRemove, self) end, self)
	self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, function() guard("cancel", self.Close, self) end, self)
	self.title:SetText(string.format("%%c[255,230,120,90]Remove the profile %s?", name))
	self.text:SetText(self:Warning())
	self.btn_remove:TextControl():SetText("Remove")
	self.btn_cancel:TextControl():SetText("Cancel")
end

function UIRemoveProfile:__finalize()
end

function UIRemoveProfile:Warning()
	local i = profile().info(self.name) or {}
	local c = i.character
	local what = c and string.format("Its character (%s items, %s RU, written %s) is taken off the list, with the copies kept for your saves.",
		type(c.items) == "table" and #c.items or 0, tostring(c.money or "?"),
		i.written and os.date("%Y-%m-%d %H:%M", i.written) or "never")
		or "It is empty: it has no character yet."
	return what
		.. " \\n \\nA backup is kept in the game's appdata folder (persistent_stalkers_profile_" .. self.name .. ".removed-<time>.txt); it can be put back only by hand."
		.. " \\n \\nTo play the character again later: create a new profile, select it, and load a save played with it (or join that game). A new profile takes the character of the first game played with it, so it becomes the character as that save holds it. What the profile gained after that save is only in the backup."
		.. " \\n \\ndefault is selected after removing."
end

function UIRemoveProfile:OnRemove()
	local ok, msg = self.panel:Remove(self.name)
	if not ok then
		self.text:SetText("%c[255,230,120,90]" .. tostring(msg))
		return
	end
	self:Close()
end

function UIRemoveProfile:Close()
	if self:IsShown() then
		self:HideDialog()
	end
end

function UIRemoveProfile:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:Close()
		return true
	end
	return res
end

------------------------------------------------------------------ debug switch

-- The panel in a window of its own, in a game, debug mode only (F8).
class "UISwitchMenu" (CUIScriptWnd)

GUI = nil
local closed_by_key = false -- F8 closed the window: its release must not open it again
local pending_switch -- a profile chosen in the window, switched to on the next update

function UISwitchMenu:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)
	self.panel = ProfilePanel(self, "switch")
end

function UISwitchMenu:__finalize()
end

function UISwitchMenu:Update()
	CUIScriptWnd.Update(self)
	if self.panel then
		local ok, err = pcall(self.panel.Update, self.panel)
		if not ok then
			log("! switch menu failed (%s)", tostring(err))
			self.panel = nil
		end
	end
end

function UISwitchMenu:Close()
	if self.panel then
		self.panel:HideCard()
	end
	if self:IsShown() then
		self:HideDialog()
	end
end

function UISwitchMenu:Finish(name)
	self:Close()
	pending_switch = name
	log("switch menu: %s", tostring(name))
end

function UISwitchMenu:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:Close()
			return true
		elseif dik == SWITCH_KEY then
			closed_by_key = true
			self:Close()
			return true
		end
	end
	return res
end

function is_open()
	return GUI ~= nil and GUI:IsShown()
end

-- Opens the debug switch window. Returns true when it is open.
function open()
	if not (db.actor and debug_mode()) then
		return false
	end
	if is_open() then
		return true
	end
	pcall(hide_hud_inventory)
	local ok, w = pcall(function() return UISwitchMenu() end)
	if not ok then
		log("! the switch menu could not be built: %s", tostring(w))
		return false
	end
	GUI = w
	GUI:ShowDialog(true)
	log("switch menu open")
	return true
end

function close()
	if is_open() then
		GUI:Close()
	end
	GUI = nil
end

local function on_key_press(key)
	if key == SWITCH_KEY then
		closed_by_key = false
	end
end

local function on_key_release(key)
	if key ~= SWITCH_KEY or not debug_mode() then
		return
	end
	if closed_by_key then
		closed_by_key = false
		return
	end
	if is_open() then
		return
	end
	local ok, why = core().can_switch()
	if ok then
		open()
	elseif why then
		core().tip(why)
	end
end

local function on_update()
	if pending_switch then
		local name = pending_switch
		pending_switch = nil
		guard("switch", core().switch_to, name)
	end
end

local function on_net_destroy()
	close()
	pending_switch = nil
end

function on_game_start()
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("actor_on_update", on_update)
	RegisterScriptCallback("actor_on_net_destroy", on_net_destroy)
end

function on_game_end()
	close()
	UnregisterScriptCallback("on_key_press", on_key_press)
	UnregisterScriptCallback("on_key_release", on_key_release)
	UnregisterScriptCallback("actor_on_update", on_update)
	UnregisterScriptCallback("actor_on_net_destroy", on_net_destroy)
end

------------------------------------------------------------------ attach

-- Called by the main menu when it is made. Returns the panel, or nil when it
-- could not be built (the menu then works without it).
function attach(mm)
	local how = level.present() and "pause" or "menu"
	local ok, panel = pcall(function() return ProfilePanel(mm, how) end)
	if not ok then
		log("! the profile panel could not be built: %s", tostring(panel))
		return nil
	end
	return panel
end
