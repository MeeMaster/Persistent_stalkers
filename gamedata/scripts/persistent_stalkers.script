-- Persistent Stalkers: a character profile that travels between worlds
-- (AGENTS.md). A profile holds one character (persistent_stalkers_profile,
-- persistent_stalkers_state). Which profile a game plays is chosen in the
-- profile menu (persistent_stalkers_menu), shown after a load when the save
-- was not last played with the selected profile, and opened with the menu key
-- to switch. MCM "Save mode" decides how the chosen profile relates to the
-- save:
--
--   off      nothing is read or written, and no menu.
--   profile  (A) the character lives apart from the save. The profile is
--            written on every change (1 s after it, and every 5 s), and on
--            every load or join of a world played with it the actor is made
--            to match it, whatever the save or xrRazom restored. Health,
--            bleeding, body parts, radiation and psy health are the
--            exception: they are read from the loaded character and put back
--            after the gear. Reloading rolls back the world only.
--   save     (B) the character follows the save. The profile is written when
--            a save is made. Loading a save played with the profile takes the
--            character the save holds: on the host and in solo the save
--            itself, on a client the snapshot it stored under that save's
--            key. Choosing the profile for a world that has no copy of it (a
--            new game, a save from before, another profile's save) gives the
--            profile's file.
--
-- None (the menu's first row) plays the save's character and writes nothing.
-- Every save remembers what it was played with (the profile, or None): on
-- the host in the save (m_data.persistent_stalkers.profile), on a client in
-- persistent_stalkers_worlds.txt under the host's save key. A load whose
-- save matches the selected profile goes straight through; any other asks.
--
-- The mode and the profile are this machine's: each player in a session
-- picks their own. The host always gives every save a key (session id and a
-- counter, in the save) and sends it to everyone (pst_saved); a joining
-- client asks for the loaded save's key (pst_hello, pst_world).
--
-- On arrival (each map's first update) nothing happens until the world has
-- settled: 3 s on the host, and on a client until xrRazom's gear restore is
-- done (XrrNet():JoinSettling()) plus 5 s (xrRazom sets satiety, radiation
-- and wounds again 1 and 3 s after its restore), and until the host's save
-- key is known (at most 20 s). A level change keeps the character as it is
-- (a marker file written on on_level_changing).
--
-- Console, with the game started with -dbg:
--   run_string persistent_stalkers.status()   mode, profile, phase, stored and carried
--   run_string persistent_stalkers.write()    write the profile now
--   run_string persistent_stalkers.restore()  make the actor match the profile now
--   run_string persistent_stalkers_menu.open("switch")  the profile menu

local WRITE_EVERY = 5000 -- ms between profile checks in "profile" mode
local DIRTY_DELAY = 1000 -- ms after a change before the profile is written
local HOST_SETTLE = 3000 -- ms after a host's or solo first update
local CLIENT_SETTLE = 5000 -- ms after xrRazom's restore is done on a client
local CLIENT_MAX_WAIT = 90000 -- ms a client waits for JoinSettling at most
local WORLD_WAIT = 20000 -- ms a client waits for the save's key
local HELLO_EVERY = 3000 -- ms between a client's key requests
local REOPEN_AFTER = 1000 -- ms before an arrival menu closed by something else opens again
local LEVEL_CHANGE_FOR = 180 -- s a level change marker counts
local DEFAULT_MODE = "off"

local DEFAULTS = {
	mode = DEFAULT_MODE,
	carry_money = true,
	carry_rank = true,
	carry_goodwill = true,
	carry_faction = false,
	carry_needs = true,
	carry_mod_state = true,
	carry_skill_tree = true,
	carry_recipes = true,
	death_strip = false,
	pause_menu = false,
}

-- idle, waiting (arrival), choosing (the arrival's menu is open), applying,
-- live (a profile is in use and written), none (playing without a profile),
-- dead, off
local phase = "idle"
local arrival -- { t, settled_t, level_change, hello_t }
local next_write = 0
local loaded -- the loaded save's m_data.persistent_stalkers (host)
local session_info = {} -- { session, counter } of this world (host)
local host_key -- the key of the save the world was loaded from
local got_world = false -- a client has the host's key (or the host has none)
local pending_pick -- { name, how }: a menu choice, run on the next update
local menu_wanted = false -- MCM's "Open the profile menu": once MCM is closed
local menu_gone_t -- when the arrival's menu was found closed without a choice

local function log(fmt, ...)
	printf("[PersistentStalkers] " .. fmt, ...)
end

function tip(text)
	log("%s", text)
	if news_manager and news_manager.send_tip and db.actor then
		news_manager.send_tip(db.actor, "Persistent Stalkers: " .. text, nil, nil, 7000)
	end
end

local function profile()
	return rawget(_G, "persistent_stalkers_profile") or persistent_stalkers_profile
end

local function state()
	return rawget(_G, "persistent_stalkers_state") or persistent_stalkers_state
end

local function menu()
	return rawget(_G, "persistent_stalkers_menu") or persistent_stalkers_menu
end

function setting(key)
	local ok, v = pcall(function()
		return ui_mcm and ui_mcm.get and ui_mcm.get("persistent_stalkers/" .. key)
	end)
	if ok and v ~= nil then
		return v
	end
	return DEFAULTS[key]
end

-- MCM's Save mode is on (profile or save), whatever the profile.
function enabled()
	local m = setting("mode")
	return m == "profile" or m == "save"
end

-- The effective mode: "off" whatever MCM says while the profile is None.
function mode()
	if profile().current_profile() == profile().NONE then
		return "off"
	end
	local m = setting("mode")
	if m == "profile" or m == "save" then
		return m
	end
	return "off"
end

function get_phase()
	return phase
end

local function parts()
	return {
		money = setting("carry_money") == true,
		rank = setting("carry_rank") == true,
		goodwill = setting("carry_goodwill") == true,
		faction = setting("carry_faction") == true,
		needs = setting("carry_needs") == true,
		mod_state = setting("carry_mod_state") == true,
		skill_tree = setting("carry_skill_tree") == true,
		recipes = setting("carry_recipes") == true,
	}
end

-- The selection is kept in the profile module's own file, so the next game
-- starts from it.
local function remember(name)
	pcall(profile().set_selected, name)
end

-------------------------------------------------------------------------------
-- Session (Master Core: master_core_net)

local function session()
	return master_core_net.session()
end

local function is_host()
	return master_core_net.is_host()
end

function in_session()
	return session() ~= nil
end

local function settling()
	local ok, v = pcall(function() return XrrNet():JoinSettling() end)
	return ok and v == true
end

local function send(name, target, t)
	return master_core_net.send_table(name, target, t)
end

local function in_game()
	return db.actor ~= nil and level.present()
end

-- A death rule (DANTE) is in the middle of a death: the player is half
-- moved. Master Core's registry (master_core_world.death_busy).
local function dante_busy()
	return master_core_world.death_busy() and true or false
end

-- Another rule keeps the player alive through a death: one registered with
-- Master Core (DANTE), or G.A.M.M.A.'s Azazel or Soulslike mode.
local function death_handled()
	return master_core_world.death_rule() ~= nil
end

-------------------------------------------------------------------------------
-- Writing

-- Reads the actor and writes the profile if it changed. Only once the
-- character is live: before that the actor holds the save's or xrRazom's
-- version, and while dead or during DANTE's death return it is half moved.
function write(why)
	if not (in_game() and phase == "live") or mode() == "off" then
		return false
	end
	if not db.actor:alive() or dante_busy() or state().busy() then
		return false
	end
	local ok, c = pcall(state().read)
	if not ok then
		log("! reading the character: %s", tostring(c))
		return false
	end
	local okn, nick = pcall(function() return XrrNet():GetNickName() end)
	c.nick = okn and type(nick) == "string" and nick ~= "" and nick or nil
	return profile().write_character(c, why)
end

local function mark_dirty()
	if phase == "live" and mode() == "profile" then
		next_write = math.min(next_write, time_global() + DIRTY_DELAY)
	end
end

-- What a save made now was played with: the profile in use, None, or nil
-- while that is not decided yet (arrival, the menu, an apply). Only a live
-- character is the profile's: a new game's first autosave is made on
-- fake_start before the arrival has settled, and once named the profile, so
-- "save" mode then followed that save's starting kit instead of applying the
-- profile (2026-11-11). Undecided, a save keeps what the loaded save said.
local function played_with()
	if phase == "live" or phase == "dead" then
		return profile().current_profile()
	end
	if phase == "none" then
		return profile().NONE
	end
	return nil
end

-------------------------------------------------------------------------------
-- Level change marker: Lua restarts on a client after a map change, so the
-- marker is a file. Written on on_level_changing, read and emptied on the
-- next first update.

local function marker_path()
	return getFS():update_path("$app_data_root$", "persistent_stalkers_level_change.txt")
end

local function write_marker()
	local f = io.open(marker_path(), "wb")
	if f then
		f:write(profile().encode({ profile = profile().current_profile(), mode = mode(), t = os.time() }))
		f:close()
	end
end

local function take_marker()
	local f = io.open(marker_path(), "rb")
	if not f then
		return false
	end
	local text = f:read("*a")
	f:close()
	if text == "" then
		return false
	end
	f = io.open(marker_path(), "wb") -- the engine has no os.remove
	if f then f:close() end
	local t = profile().decode(text)
	return type(t) == "table" and t.profile == profile().current_profile() and t.mode == mode()
		and type(t.t) == "number" and os.time() - t.t <= LEVEL_CHANGE_FOR
end

-------------------------------------------------------------------------------
-- Arrival: wait, decide (or ask), apply

local function go_live(why, no_write)
	phase = "live"
	next_write = time_global() + WRITE_EVERY
	if not no_write then
		write(why)
	end
end

local function go_none(why)
	phase = "none"
	log("no profile: %s", why)
end

local function after_apply(report, what)
	go_live("applied")
	local bad = report.missing + report.refused + report.misplaced
	tip(string.format("%s%s", what or ("character " .. profile().current_profile() .. " restored"),
		bad > 0 and string.format(" (%s items missing, %s could not be removed, %s not in place: see the log)", report.missing, report.refused, report.misplaced) or ""))
end

local function apply_character(c, why, what)
	phase = "applying"
	log("%s: making the character match %s (%s)", why, profile().current_profile(), state().summary(c))
	if not state().apply(c, parts(), function(report) after_apply(report, what) end) then
		go_live("apply refused")
	end
end

-- Which character this world should have for the selected profile, by mode.
-- nil: the actor as it is.
local function target()
	local p = profile()
	local stored = p.character()
	if mode() == "profile" then
		return stored, stored and "the profile" or "a new profile takes the character as it is"
	end
	if is_host() then
		if loaded and loaded.profile == p.current_profile() then
			return nil, "the save was last played with this profile: the character follows it"
		end
		return stored, stored and "this save has no copy of this profile: the profile" or "a new profile takes the character as it is"
	end
	local snap = host_key and host_key ~= "" and p.snapshot(host_key)
	if snap then
		return snap, "the copy kept for save " .. host_key
	end
	return stored, stored and string.format("no copy for save %s: the profile", tostring(host_key)) or "a new profile takes the character as it is"
end

local function apply_target(what)
	local c, why = target()
	if c then
		apply_character(c, why, what)
	else
		log("%s", why)
		go_live(why)
		if what then
			tip(what)
		end
	end
end

-- What the loaded world was last played with: the profile, None, or nil
-- (never with this mod on, or a new game).
function world_tag()
	if is_host() then
		return loaded and loaded.profile or nil
	end
	return host_key and profile().world_profile(host_key) or nil
end

local function ask()
	phase = "choosing"
	menu_gone_t = nil
	local ok, res = pcall(function() return menu().open("arrival") end)
	if not ok or res == false then
		log("! the profile menu did not open: %s", tostring(res))
		go_none("the menu did not open")
		tip("the profile menu could not open: you keep this save's character and nothing is written. Try the menu key.")
	end
end

local function decide()
	local p = profile()
	if arrival.level_change then
		arrival = nil
		log("level change: the character carries on as it is")
		if p.current_profile() == p.NONE then
			go_none("level change")
		else
			-- "save" mode writes only at saves and loads
			go_live("level change", mode() == "save")
		end
		return
	end
	arrival = nil
	local sel, tag = p.current_profile(), world_tag()
	if tag and tag == sel then
		if sel == p.NONE then
			go_none("this world was last played without a profile")
		else
			apply_target()
		end
		return
	end
	log("this world was last played with %s, %s is selected: asking", tostring(tag or "nothing"), sel)
	ask()
end

local function arrival_update(now)
	if not is_host() then
		if not arrival.settled_t then
			if settling() and now - arrival.t < CLIENT_MAX_WAIT then
				return
			end
			arrival.settled_t = now
		end
		if not got_world and now >= (arrival.hello_t or 0) then
			arrival.hello_t = now + HELLO_EVERY
			send("pst_hello", "host", { v = 1 })
		end
		if now - arrival.settled_t < CLIENT_SETTLE then
			return
		end
		if not got_world and now - arrival.t < WORLD_WAIT then
			return
		end
	elseif now - arrival.t < HOST_SETTLE then
		return
	end
	decide()
end

local function start_arrival(level_change)
	if not enabled() then
		phase = "off"
		return
	end
	phase = "waiting"
	arrival = { t = time_global(), level_change = level_change }
end

local function on_first_update()
	profile().pin()
	local lc = take_marker()
	if not is_host() then
		got_world = false
		host_key = nil
	end
	start_arrival(lc)
end

-------------------------------------------------------------------------------
-- The profile menu's choices (persistent_stalkers_menu). pick() is called by
-- the menu; the choice runs on the next update, once the menu is closed (and
-- the game unpaused).
--   arrival  the world's first choice: the profile's character for this
--            world (target(): in "save" mode a save played with it keeps
--            its own), or None.
--   switch   during play: the profile in use is written first, then the new
--            one's character (its file) replaces the actor. None stops
--            using a profile; the character stays.
-- A profile with no character yet (a new one) takes the character as it is:
-- a copy, so a playthrough can go two ways.

-- Can the menu be opened to switch now? Returns ok, why.
function can_switch()
	if not enabled() then
		return false, "Save mode is Off in MCM."
	end
	if not in_game() then
		return false, nil
	end
	if pending_pick or state().busy() or phase == "applying" then
		return false, "a restore is running"
	end
	if phase == "waiting" or phase == "choosing" or phase == "idle" then
		return false, "the character is still being restored after the load"
	end
	if phase == "dead" or not db.actor:alive() or dante_busy() then
		return false, "not while dying"
	end
	return phase == "live" or phase == "none", nil
end

function pick(name, how)
	pending_pick = { name = name, how = how }
	log("menu (%s): %s", how, tostring(name))
end

-- The menu's line about what choosing name does.
function describe_choice(name, how)
	local p = profile()
	local cur = phase == "live" and p.current_profile() or nil
	if name == p.NONE then
		if how == "arrival" then
			return "Play the character this save loaded, without a profile. Nothing is written to any profile."
		end
		if cur then
			return string.format("Stop using %s: it is saved now, and nothing is written after. You keep the character you have.", cur)
		end
		return "You are playing without a profile."
	end
	local i = p.info(name)
	local empty = not (i and i.character)
	if how == "switch" and name == cur then
		return string.format("You are playing as %s.", name)
	end
	local first = how == "switch" and cur and string.format("%s is saved now. ", cur) or ""
	if empty then
		return first .. string.format("%s is empty: it takes the character you have now (a copy).", name)
	end
	if how == "arrival" then
		if setting("mode") == "save" and is_host() and loaded and loaded.profile == name then
			return string.format("This save was played as %s: you keep the save's character, and %s follows your saves from now on.", name, name)
		end
		if setting("mode") == "save" and not is_host() then
			return string.format("The copy of %s kept for this save (if there is one, else %s's character) replaces the one you joined with: gear, and what is ticked in MCM. Health and bleeding stay.", name, name)
		end
		return string.format("%s's character replaces the one this save loaded: gear, and what is ticked in MCM. Health and bleeding stay the save's.", name)
	end
	return first .. string.format("Then %s's character replaces yours: gear, and what is ticked in MCM. Health and bleeding stay. Save the game afterwards so your saves follow %s.", name, name)
end

local function run_pick(pk)
	local p = profile()
	if not in_game() then
		return
	end
	if pk.how == "switch" then
		if state().busy() or not db.actor:alive() or dante_busy() then
			tip("could not switch profiles now")
			return
		end
		if (pk.name == p.NONE and phase == "none") or (pk.name == p.current_profile() and phase == "live") then
			return
		end
		if phase == "live" then
			write("switching to " .. pk.name)
		end
	elseif phase ~= "choosing" then
		return -- the arrival was cancelled (mode switched off)
	end
	if pk.name ~= p.current_profile() then
		log("profile: %s -> %s", p.current_profile(), pk.name)
	end
	p.use_profile(pk.name)
	remember(pk.name)
	if pk.name == p.NONE then
		go_none("chosen in the menu")
		tip(pk.how == "arrival" and "playing this save's character without a profile: nothing is written"
			or "no profile now: you keep your character, and nothing is written")
		return
	end
	if pk.how == "arrival" then
		apply_target()
		return
	end
	local c = p.character()
	local what = string.format("playing as %s; save the game so your saves follow it", pk.name)
	if c then
		apply_character(c, "switched in the menu", what)
	else
		go_live("a new profile takes the character as it is")
		tip(what)
	end
end

-- MCM's "Open the profile menu" button: opened once MCM is closed.
function request_menu()
	menu_wanted = true
end

local function mcm_open()
	local ok, shown = pcall(function()
		local g = ui_mcm.get_gui and ui_mcm.get_gui()
		return g and g:IsShown()
	end)
	return ok and shown and true or false
end

local function update()
	local now = time_global()
	state().update()
	if pending_pick then
		local pk = pending_pick
		pending_pick = nil
		run_pick(pk)
	elseif phase == "waiting" and arrival then
		arrival_update(now)
	elseif phase == "choosing" then
		-- something else closed the arrival's menu (a death, another mod's
		-- dialog): open it again
		if not menu().is_open() and db.actor:alive() then
			menu_gone_t = menu_gone_t or now
			if now - menu_gone_t >= REOPEN_AFTER then
				log("the profile menu was closed without a choice: opening it again")
				ask()
			end
		else
			menu_gone_t = nil
		end
	elseif phase == "live" and mode() == "profile" and now >= next_write then
		next_write = now + WRITE_EVERY
		write()
	elseif phase == "dead" and db.actor and db.actor:alive() and not dante_busy() then
		-- the death was cancelled after all
		go_live("alive again")
	end
	if menu_wanted and not mcm_open() then
		menu_wanted = false
		local ok, why = can_switch()
		if ok then
			menu().open("switch")
		elseif why then
			tip(why)
		end
	end
end

-------------------------------------------------------------------------------
-- Saves (host): every save gets a key, sent to everyone, and what it was
-- played with.

local function new_session()
	return string.format("%x%04x", os.time(), math.random(0, 65535))
end

local function save_state(m_data)
	if not is_host() then
		return -- a client's save_state is xrRazom's surrogate, not a save
	end
	session_info.session = session_info.session or new_session()
	session_info.counter = (session_info.counter or 0) + 1
	local key = session_info.session .. "-" .. session_info.counter
	local with = enabled() and (played_with() or (loaded and loaded.profile)) or nil
	m_data.persistent_stalkers = { session = session_info.session, counter = session_info.counter, key = key,
		profile = with, mode = mode() }
	host_key = key
	send("pst_saved", nil, { key = key })
	if mode() ~= "off" then
		write("game saved")
	end
end

local function load_state(m_data)
	if not is_host() then
		return
	end
	local t = m_data.persistent_stalkers
	loaded = type(t) == "table" and { session = t.session, counter = t.counter, key = t.key, profile = t.profile, mode = t.mode } or nil
	session_info = { session = loaded and loaded.session, counter = loaded and loaded.counter }
	host_key = loaded and loaded.key
end

-------------------------------------------------------------------------------
-- Events

local function ev_hello(args, sender)
	if is_host() then
		send("pst_world", sender, { key = host_key or "" })
	end
end

local function ev_world(args)
	if is_host() then
		return
	end
	local t = profile().decode(args)
	if type(t) == "table" then
		host_key = t.key ~= "" and t.key or nil
		got_world = true
		log("the host's save key: %s", tostring(host_key))
	end
end

local function ev_saved(args)
	if is_host() then
		return
	end
	local t = profile().decode(args)
	if not (type(t) == "table" and type(t.key) == "string") then
		return
	end
	host_key = t.key
	got_world = true
	local with = enabled() and played_with()
	if with then
		profile().set_world_profile(t.key, with)
	end
	if phase ~= "live" or not db.actor or not db.actor:alive() then
		log("host saved (%s); not live here, no snapshot", t.key)
		return
	end
	if mode() == "save" then
		local ok, c = pcall(state().read)
		if ok then
			profile().write_character(c, "host saved " .. t.key)
			profile().store_snapshot(t.key, c)
		end
	elseif mode() == "profile" then
		write("host saved")
	end
end

-------------------------------------------------------------------------------
-- Callbacks

local function on_level_changing()
	if phase == "live" or phase == "none" then
		if mode() == "profile" then
			write("level change")
		end
		write_marker()
	end
	state().cancel()
end

local function close_menu()
	pcall(function() menu().close() end)
end

local function on_net_destroy()
	state().cancel()
	close_menu()
	arrival = nil
	pending_pick = nil
	menu_wanted = false
	if phase ~= "off" then
		phase = "idle"
	end
end

-- Death with nothing to keep the player alive (no DANTE, Azazel, Soulslike):
-- in "profile" mode the reload brings back the world, not the gear.
-- The profile keeps the gear as it was a moment before death, or, with
-- MCM "death_strip", loses what was carried (equipped binoculars, PDA and
-- torch stay, as with DANTE). Health and bleeding stay with the save.
local function kept_slot(slot)
	for _, s in ipairs(master_core_world.KEEP_SLOTS) do
		if s == slot then
			return true
		end
	end
	return false
end

local function on_before_death(who_id, flags)
	if phase ~= "live" or mode() ~= "profile" or death_handled() or (flags and flags.ret_value == false) then
		return
	end
	if setting("death_strip") == true then
		local ok, c = pcall(state().read)
		if ok then
			local kept = {}
			for _, it in ipairs(c.items) do
				if it.slot and kept_slot(it.slot) then
					kept[#kept + 1] = it
				end
			end
			log("death: %s of %s items lost from the profile", #c.items - #kept, #c.items)
			c.items = kept
			profile().write_character(c, "death")
		end
	end
	phase = "dead"
end

local function on_item()
	mark_dirty()
end

local function on_mode_changed()
	mark_dirty()
end

-- No wait: the world is settled.
local function start_now()
	start_arrival(false)
	if arrival then
		arrival.t = time_global() - CLIENT_MAX_WAIT
		arrival.settled_t = time_global() - CLIENT_SETTLE
	end
end

-- MCM Apply. Switched off mid-game, the mod stops at once. Switched on
-- mid-game, it waits for the next load or join: starting now would replace
-- the character in front of the player.
local function on_option_change()
	if not in_game() then
		return
	end
	if not enabled() then
		if phase ~= "off" then
			log("mode off")
		end
		state().cancel()
		close_menu()
		arrival = nil
		pending_pick = nil
		phase = "off"
	elseif phase == "off" or phase == "idle" then
		tip("switched on: it starts when you next load a save or join a game")
	end
end

-------------------------------------------------------------------------------
-- Console

function status()
	local p = profile()
	local lines = {
		string.format("mode %s, profile %s (revision %s), phase %s, %s, save key %s, played with %s, snapshots %s", mode(),
			p.current_profile(), tostring(p.revision()), phase, is_host() and "host" or "client", tostring(host_key),
			tostring(world_tag()), tostring(p.snapshot_count())),
		"file " .. p.path(),
		"stored: " .. state().summary(p.character()),
	}
	if in_game() then
		local ok, c = pcall(state().read)
		lines[#lines + 1] = "carried: " .. (ok and state().summary(c) or tostring(c))
	end
	for _, l in ipairs(lines) do
		tip(l)
	end
end

function restore()
	if not in_game() then
		return
	end
	local c = profile().character()
	if not c then
		tip("the profile holds no character yet")
		return
	end
	if state().busy() then
		tip("a restore is already running")
		return
	end
	apply_character(c, "console")
end

-------------------------------------------------------------------------------

function on_game_start()
	if not (master_core and master_core.need) then
		log("! Master Core is not installed: Persistent Stalkers is off")
		return
	end
	master_core.need("Persistent Stalkers", 1)
	RegisterScriptCallback("actor_on_first_update", on_first_update)
	RegisterScriptCallback("actor_on_update", update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("on_level_changing", on_level_changing)
	RegisterScriptCallback("actor_on_net_destroy", on_net_destroy)
	RegisterScriptCallback("actor_on_before_death", on_before_death)
	RegisterScriptCallback("actor_on_item_take", on_item)
	RegisterScriptCallback("actor_on_item_drop", on_item)
	RegisterScriptCallback("actor_on_item_use", on_item)
	RegisterScriptCallback("actor_on_item_put_in_box", on_item)
	RegisterScriptCallback("actor_on_item_take_from_box", on_item)
	RegisterScriptCallback("ActorMenu_on_mode_changed", on_mode_changed)
	RegisterScriptCallback("on_option_change", on_option_change)
	master_core_net.register("pst_hello", ev_hello)
	master_core_net.register("pst_world", ev_world)
	master_core_net.register("pst_saved", ev_saved)
end

function on_game_end()
	state().cancel()
	close_menu()
	UnregisterScriptCallback("actor_on_first_update", on_first_update)
	UnregisterScriptCallback("actor_on_update", update)
	UnregisterScriptCallback("save_state", save_state)
	UnregisterScriptCallback("load_state", load_state)
	UnregisterScriptCallback("on_level_changing", on_level_changing)
	UnregisterScriptCallback("actor_on_net_destroy", on_net_destroy)
	UnregisterScriptCallback("actor_on_before_death", on_before_death)
	UnregisterScriptCallback("actor_on_item_take", on_item)
	UnregisterScriptCallback("actor_on_item_drop", on_item)
	UnregisterScriptCallback("actor_on_item_use", on_item)
	UnregisterScriptCallback("actor_on_item_put_in_box", on_item)
	UnregisterScriptCallback("actor_on_item_take_from_box", on_item)
	UnregisterScriptCallback("ActorMenu_on_mode_changed", on_mode_changed)
	UnregisterScriptCallback("on_option_change", on_option_change)
end

-- After persistent_stalkers_dev.reload(): the world is already settled.
function on_reload()
	if in_game() and (phase == "idle" or phase == "waiting") and enabled() then
		start_now()
	end
end

-- Carried over by persistent_stalkers_dev.reload().
function get_state()
	return { phase = phase, loaded = loaded, session_info = session_info, host_key = host_key, got_world = got_world,
		next_write = next_write }
end

function set_state(s)
	phase = s.phase == "applying" and "live" or s.phase or "idle"
	loaded = s.loaded
	session_info = s.session_info or {}
	host_key = s.host_key
	got_world = s.got_world
	next_write = s.next_write or 0
end
