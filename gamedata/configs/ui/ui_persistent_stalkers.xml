<w>
	<!-- The main menu with the profile panel (ui_main_menu.script, persistent_stalkers_menu.script).
	     Positions are 1024x768 units. The game's options (the engine's button list) come from the
	     stock ui_mm_main.xml and are moved to the right by the script (options); the background
	     here is G.A.M.M.A.'s with its logo and badges moved into the right column.
	     Placeholder look: stock frame, button, edit box and font textures. Rows, slot boxes,
	     icons, bars and counts are placed by the script; their sizes here are overridden. -->

	<background x="0" y="0" width="1024" height="768">
		<auto_static x="0" y="0" width="1024" height="768" stretch="1">
			<texture x="0" y="0" width="1920" height="1080">ui\ui_background_new</texture>
		</auto_static>
		<auto_static x="782" y="14" width="230" height="133" stretch="1">
			<texture>GAMMAMainMenuLogo.dds</texture>
		</auto_static>
		<auto_static x="787" y="152" width="55" height="64" stretch="1">
			<texture>ui\moty2018</texture>
		</auto_static>
		<auto_static x="842" y="152" width="55" height="64" stretch="1">
			<texture>ui\moty2019</texture>
		</auto_static>
		<auto_static x="897" y="152" width="55" height="64" stretch="1">
			<texture>LogoAMCM.dds</texture>
		</auto_static>
		<auto_static x="952" y="152" width="55" height="64" stretch="1">
			<texture>LogoGAMMA.dds</texture>
		</auto_static>
	</background>

	<!-- Where the engine's button list goes: its buttons region (220 wide, 8 from the
	     window's left in the stock layout) ends 16 units from the right edge. -->
	<options x="780" y="419" width="10" height="10"/>

	<menu>
		<!-- the panel: left to middle -->
		<panel x="12" y="12" width="756" height="720"/>
		<background x="0" y="0" width="756" height="720" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="20" y="10" width="716" height="30" stretch="1">
			<text font="letterica25" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>

		<!-- Left: the profiles (ROWS rows from row's position, 3 apart), paging, a new profile -->
		<list_title x="18" y="46" width="184" height="22" stretch="1">
			<text font="letterica18" r="200" g="200" b="200" align="l" vert_align="c"/>
		</list_title>
		<!-- a check button: the selected row is kept checked (pressed); its text is row_text -->
		<row x="18" y="72" width="184" height="26" stretch="1">
			<texture>ui_button_ordinary</texture>
		</row>
		<row_text x="0" y="0" width="10" height="26" stretch="1">
			<text font="letterica16" r="225" g="220" b="200" align="l" vert_align="c"/>
		</row_text>
		<btn_up x="18" y="422" width="90" height="24" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_up>
		<btn_down x="112" y="422" width="90" height="24" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_down>
		<btn_new x="18" y="456" width="184" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_new>
		<!-- shown for a selected profile other than default, at the main menu -->
		<btn_remove x="18" y="492" width="184" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_remove>
		<!-- under the list: the save mode -->
		<note x="18" y="534" width="184" height="172" stretch="1" complex_mode="1">
			<text font="letterica16" r="170" g="170" b="160" align="l" vert_align="t" complex_mode="1"/>
		</note>

		<!-- Right of the list: the selected row's name and stats; its equipment as G.A.M.M.A.'s
		     inventory shows it (the script sets the column's width from its height), the backpack
		     beside it (the script puts it right of the column, up to bag's right edge); what
		     playing with it does -->
		<details x="214" y="46" width="530" height="76" stretch="1" complex_mode="1">
			<text font="letterica16" r="210" g="210" b="210" align="l" vert_align="t" complex_mode="1"/>
		</details>
		<equip x="214" y="128" width="240" height="500" stretch="1"/>
		<inv_back x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_inventory_back</texture>
		</inv_back>
		<helmet_blocker x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_helmet_blocker</texture>
		</helmet_blocker>
		<artefact_blocker x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_artefact_blocker</texture>
		</artefact_blocker>
		<slot_bar x="0" y="0" width="10" height="6" stretch="1">
			<texture r="142" g="149" b="149">ui_inGame2_inventory_status_bar</texture>
		</slot_bar>
		<bag_caption x="464" y="128" width="280" height="18" stretch="1">
			<text font="letterica16" r="170" g="170" b="160" align="l" vert_align="c"/>
		</bag_caption>
		<bag x="464" y="148" width="280" height="480" stretch="1">
			<texture r="12" g="14" b="12" a="160">ui_inGame2_white_rect</texture>
		</bag>
		<layer x="0" y="0" width="10" height="10"/>
		<slot_bg x="0" y="0" width="10" height="10" stretch="1">
			<texture r="40" g="42" b="38" a="200">ui_inGame2_white_rect</texture>
		</slot_bg>
		<icon x="0" y="0" width="10" height="10" stretch="1"/>
		<bar x="0" y="0" width="10" height="2" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</bar>
		<count x="0" y="0" width="30" height="13" stretch="1">
			<text font="letterica16" r="235" g="235" b="225" align="r" vert_align="c"/>
		</count>
		<what x="214" y="636" width="530" height="74" stretch="1" complex_mode="1">
			<text font="letterica16" r="210" g="210" b="210" align="l" vert_align="t" complex_mode="1"/>
		</what>
	</menu>

	<!-- The "New profile" box, shown over the main menu -->
	<new_profile>
		<background x="312" y="284" width="400" height="200" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="332" y="298" width="360" height="26" stretch="1">
			<text font="letterica18" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>
		<name x="332" y="332" width="360" height="26" stretch="1">
			<texture>ui_inGame2_edit_box_1</texture>
			<text x="3" font="letterica18" vert_align="c"/>
		</name>
		<hint x="332" y="364" width="360" height="66" stretch="1" complex_mode="1">
			<text font="letterica16" r="190" g="190" b="180" align="l" vert_align="t" complex_mode="1"/>
		</hint>
		<btn_create x="332" y="440" width="174" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_create>
		<btn_cancel x="518" y="440" width="174" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</new_profile>

	<!-- The "Remove profile" warning, shown over the main menu -->
	<remove_profile>
		<background x="262" y="204" width="500" height="360" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="282" y="218" width="460" height="26" stretch="1">
			<text font="letterica18" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>
		<message x="282" y="252" width="460" height="252" stretch="1" complex_mode="1">
			<text font="letterica16" r="210" g="210" b="200" align="l" vert_align="t" complex_mode="1"/>
		</message>
		<btn_remove x="282" y="516" width="220" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_remove>
		<btn_cancel x="522" y="516" width="220" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</remove_profile>
</w>
