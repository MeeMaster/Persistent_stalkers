<w>
	<!-- The main menu (ui_main_menu.script, persistent_stalkers_menu.script).
	     Positions are 1024x768 units. The profile box is on the left: the list,
	     and beside it the inventory (the equipment column and the backpack).
	     The game's options stay the engine's list in the right half, with no
	     frame of their own. The debug F8 window uses ui_persistent_stalkers_full.xml. -->

	<!-- G.A.M.M.A.'s background. The logo and badges are nodes of their own:
	     the script draws each only when its texture is installed (a missing
	     texture draws a grey box), and without G.A.M.M.A.'s background or logo
	     it takes ui_mm_main.xml's background instead (base Anomaly's art). -->
	<background x="0" y="0" width="1024" height="768">
		<auto_static x="0" y="0" width="1024" height="768" stretch="1">
			<texture x="0" y="0" width="1920" height="1080">ui\ui_background_new</texture>
		</auto_static>
	</background>
	<!-- As base Anomaly's menu: the big logo across the top, the profile box
	     (menu:panel) on the left and the options right of it, and the badges,
	     the disclaimer and the version along the bottom. -->
	<logo_main x="287" y="4" width="450" height="340" stretch="1">
		<texture>GAMMAMainMenuLogo.dds</texture>
	</logo_main>
	<logo_1 x="12" y="690" width="55" height="64" stretch="1">
		<texture>ui\moty2018</texture>
	</logo_1>
	<logo_2 x="67" y="690" width="55" height="64" stretch="1">
		<texture>ui\moty2019</texture>
	</logo_2>
	<logo_3 x="122" y="690" width="55" height="64" stretch="1">
		<texture>LogoAMCM.dds</texture>
	</logo_3>
	<logo_4 x="177" y="690" width="55" height="64" stretch="1">
		<texture>LogoGAMMA.dds</texture>
	</logo_4>

	<!-- The engine's button list, right of the profile box (which ends at
	     x 527). Its button region is 220 wide and starts 8 units in from this
	     spot, so x 657 centres it in the space right of the box; y with the
	     box's top. -->
	<options x="657" y="282" width="10" height="10"/>
	<!-- the disclaimer and the version, along the bottom right of the badges
	     (base Anomaly's badges are at x 15 to 235 too) -->
	<disclaimer x="250" y="676" width="762" height="56"/>
	<version x="250" y="738" width="762" height="20"/>

	<menu>
		<!-- list on the left of the box; inventory on the right of it.
		     8 rows from row, 3 apart. The script sets the column's width from
		     its height and puts the backpack right of it, up to the bag's right
		     edge here (a tall strip). The box sits under the logo, the options to its right. -->
		<panel x="12" y="260" width="515" height="400"/>
		<background x="0" y="0" width="515" height="400" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="12" y="8" width="164" height="22" stretch="1">
			<text font="letterica18" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>
		<list_title x="12" y="34" width="164" height="16" stretch="1">
			<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
		</list_title>
		<row x="12" y="54" width="164" height="24" stretch="1">
			<texture>ui_button_ordinary</texture>
		</row>
		<row_text x="0" y="0" width="10" height="24" stretch="1">
			<text font="letterica16" r="225" g="220" b="200" align="l" vert_align="c"/>
		</row_text>
		<btn_up x="12" y="278" width="78" height="24" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_up>
		<btn_down x="98" y="278" width="78" height="24" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_down>
		<btn_new x="12" y="308" width="78" height="26" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_new>
		<btn_remove x="98" y="308" width="78" height="26" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_remove>
		<btn_lobby x="12" y="342" width="164" height="28" check_mode="0" stretch="1">
			<text font="letterica16" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_lobby>
		<bag_caption x="383" y="8" width="120" height="18" stretch="1">
			<text font="letterica16" r="170" g="170" b="160" align="l" vert_align="c"/>
		</bag_caption>
		<bag x="383" y="28" width="120" height="368" stretch="1">
			<texture r="12" g="14" b="12" a="160">ui_inGame2_white_rect</texture>
		</bag>

		<equip x="188" y="8" width="200" height="384" stretch="1"/>
		<inv_back x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_inventory_back</texture>
		</inv_back>
		<helmet_blocker x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_helmet_blocker</texture>
		</helmet_blocker>
		<artefact_blocker x="0" y="0" width="10" height="10" stretch="1">
			<texture>ui_inGame2_artefact_blocker</texture>
		</artefact_blocker>
		<slot_bar x="0" y="0" width="10" height="6" stretch="1">
			<texture r="142" g="149" b="149">ui_inGame2_inventory_status_bar</texture>
		</slot_bar>
		<layer x="0" y="0" width="10" height="10"/>
		<slot_bg x="0" y="0" width="10" height="10" stretch="1">
			<texture r="40" g="42" b="38" a="200">ui_inGame2_white_rect</texture>
		</slot_bg>
		<icon x="0" y="0" width="10" height="10" stretch="1"/>
		<bar x="0" y="0" width="10" height="2" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</bar>
		<count x="0" y="0" width="30" height="13" stretch="1">
			<text font="letterica16" r="235" g="235" b="225" align="r" vert_align="c"/>
		</count>
	</menu>

	<!-- The "New profile" box, shown over the main menu -->
	<new_profile>
		<background x="312" y="284" width="400" height="200" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="332" y="298" width="360" height="26" stretch="1">
			<text font="letterica18" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>
		<name x="332" y="332" width="360" height="26" stretch="1">
			<texture>ui_inGame2_edit_box_1</texture>
			<text x="3" font="letterica18" vert_align="c"/>
		</name>
		<hint x="332" y="364" width="360" height="66" stretch="1" complex_mode="1">
			<text font="letterica16" r="190" g="190" b="180" align="l" vert_align="t" complex_mode="1"/>
		</hint>
		<btn_create x="332" y="440" width="174" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_create>
		<btn_cancel x="518" y="440" width="174" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</new_profile>

	<!-- The "Remove profile" warning, shown over the main menu -->
	<remove_profile>
		<background x="262" y="204" width="500" height="360" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</background>
		<title x="282" y="218" width="460" height="26" stretch="1">
			<text font="letterica18" r="230" g="220" b="190" align="l" vert_align="c"/>
		</title>
		<message x="282" y="252" width="460" height="252" stretch="1" complex_mode="1">
			<text font="letterica16" r="210" g="210" b="200" align="l" vert_align="t" complex_mode="1"/>
		</message>
		<btn_remove x="282" y="516" width="220" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_remove>
		<btn_cancel x="522" y="516" width="220" height="30" check_mode="0" stretch="1">
			<text font="letterica18" r="225" g="220" b="200"/>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</remove_profile>
</w>
