; Persistent Stalkers: the lobby's place and cameras. Shipped with the mod.
;
; [actor_free_cam] is the engine's free-look zoom (read when the actor is made).
; G.A.M.M.A. starts at 0.4, 10 (5.2 m). 0.4, 6.6 starts at 3.5 m and caps zoom-out
; there. A change needs a game restart. The '!' marks the section as an override:
; actor_free_cam already exists, and an unmarked copy stops the game.
;
; [persistent_stalkers_lobby] is the lobby script's settings:
;   place      the [ps_lobby_place_<name>] the lobby uses; the lobby's spawn is
;              built for it (tools/build_lobby_spawn.sh: run it again when the
;              map or host_position changes). On a map with another place, that
;              one is used; on a map with none, the host stands where the actor
;              starts and the camera is free look.
;   spacing    m between slots. The host's slot is the first; the other four
;              follow it to the host's left (the camera's right).
;   side       1; -1 puts the other slots to the host's right instead
;   face       radians added to the bodies' heading (host_rotation)
;   glide      s the camera takes between the lineup and the close-up
;   cam_mode   the free-look camera on a map with no place (2)
;
; [ps_lobby_place_<name>]: one starting position (persistent_stalkers_place.script)
;   map            the level
;   host_position  x, y, z on that map: where the host stands
;   host_rotation  degrees, the way the host faces: 0 north (+z), 90 east (+x).
;                  The slots and every camera turn with it.
;   camera         the lineup camera from the host's slot: right, up, forward (m),
;                  yaw, pitch (degrees; yaw 0 looks the way the host looks, 180
;                  back at the host; pitch up positive)
;   close          the Change profile close-up, from each player's own slot, the
;                  same way; close_<n> (close_2 ...) gives slot n its own
;
; In the lobby, with -dbg:
;   run_string persistent_stalkers_lobby.snapshot()          the camera on screen as camera
;   run_string persistent_stalkers_lobby.snapshot("close")   ... as close, from your slot
;   run_string persistent_stalkers_lobby.snapshot("close", 3)  ... as close_3
;   run_string persistent_stalkers_lobby.tune("spacing", 1.3)  try a spacing
;   run_string persistent_stalkers_lobby_tune.where()        hand tuning (F7 in the window)
; Anywhere in a game:
;   run_string persistent_stalkers_place.here()          your map, position and yaw
;   run_string persistent_stalkers_place.add("name")     a place with you as the host,
;                                                        facing where the camera goes
;   run_string persistent_stalkers_place.choose("name")  select a place

![actor_free_cam]
lim_zoom = 0.4, 6.6

[persistent_stalkers_lobby]
place = rookie_village
spacing = 1.5
side = 1
face = 0
glide = 0.3
cam_mode = 2

; Cordon, the rookie village: the row 4 m south of the central campfire, its
; back to the fire, facing south. The cameras are the ones recorded on fake_start.
[ps_lobby_place_rookie_village]
map = l01_escape
host_position = -209.75, -20, -138.25
host_rotation = 180
camera = -2.9, 1.5, 5, 180, 0
close = 0.4, 1, 1.5, 180, 0

; fake_start, where the first lobby was (xrRazom does not host there)
[ps_lobby_place_fake_start]
map = fake_start
host_position = -2.181, 0.008, -0.019
host_rotation = 180
camera = -1.871, 1.637, 3.467, 184.69, 0
close = 0.416, 1.055, 1.435, 180, 0
